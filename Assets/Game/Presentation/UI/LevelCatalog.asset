    ScenePath: Assets/Game/Core/Scenes/Game.unity
  - Title: "\u0412\u0442\u043E\u0440\u043E\u0439 \u0437\u0430\u043B"
    Description: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438 \u043E\u0433\u0440\u0430\u0431\u043B\u0435\u043D\u0438\u0435.\n\u0414\u043E\u0431\u0435\u0440\u0438\u0441\u044C \u0434\u043E \u0432\u044B\u0445\u043E\u0434\u0430."
    Artwork: {fileID: 21300000, guid: 778b551d4b5e3220bbe19b084ecb1938, type: 3}
    ScenePath: Assets/Game/Core/Scenes/Game_Level2.unity
  - Title: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0437\u0430\u043B"
    Description: "\u0412\u044B\u043D\u0435\u0441\u0438 \u0434\u043E\u0431\u044B\u0447\u0443.\n\u0417\u0430\u0432\u0435\u0440\u0448\u0438 \u043E\u0433\u0440\u0430\u0431\u043B\u0435\u043D\u0438\u0435."
